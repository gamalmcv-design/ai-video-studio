AI_GATEWAY_API_KEY=

SCRIPT_PROVIDER_URL=
SCRIPT_PROVIDER_API_KEY=
SCRIPT_MODEL_ID=
SCRIPT_PROVIDER_TIMEOUT_MS=25000

# Optional OpenAI-compatible speech endpoint. Keep credentials server-side.
VOICE_PROVIDER_URL=
VOICE_PROVIDER_API_KEY=
VOICE_MODEL_ID=
# Optional JSON list: [{"id":"provider-voice-id","label":"Arabic voice","language":"ar","type":"female"}]
VOICE_OPTIONS_JSON=

# Optional music-generation adapter. The endpoint must accept JSON { model, preset, durationSeconds, loop }
# and return audio bytes or JSON { audioUrl }.
MUSIC_PROVIDER_URL=
MUSIC_PROVIDER_API_KEY=
MUSIC_MODEL_ID=

# Optional video-composition adapter. It must accept a project manifest and return JSON { videoUrl }.
COMPOSER_PROVIDER_URL=
COMPOSER_PROVIDER_API_KEY=

VIDEO_PROVIDER_URL=https://gateway.pixazo.ai/seedance-2-5/v1/text-to-video
VIDEO_PROVIDER_API_KEY=
VIDEO_PROVIDER_STATUS_URL=https://gateway.pixazo.ai/v2/requests/status
VIDEO_MODEL_SEEDANCE_25=seedance-2-5
VIDEO_MODEL_SPADATIS_20=
